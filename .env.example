# Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# SendGrid API key for email delivery
# Railway/GCP blocks outbound SMTP, so we use the SendGrid HTTP API instead.
# Sign up free at https://sendgrid.com, verify your sender email, then:
#   Settings → API Keys → Create API Key → Restricted → Mail Send: Full Access
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# Email addresses
EMAIL_FROM=jason.spitalnick@gmail.com
EMAIL_TO=jspitalnick@swlaw.com
